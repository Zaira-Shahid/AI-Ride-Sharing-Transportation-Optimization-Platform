{
  "name": "ridemesh",
  "version": "0.0.0",
  "private": true,
  "description": "RideMesh - AI-powered ride-sharing optimization platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:firebase": "vitest run --config vitest.live.config.mts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev:admin": "npm run dev --workspace @ridemesh/admin",
    "dev:passenger": "npm run start --workspace @ridemesh/passenger",
    "dev:driver": "npm run start --workspace @ridemesh/driver",
    "build:functions": "npm run build --workspace @ridemesh/functions",
    "emulators": "npm run build:functions && firebase emulators:start",
    "emulators:persist": "npm run build:functions && node -e \"require('fs').mkdirSync('emulator-data',{recursive:true})\" && firebase emulators:start --import ./emulator-data --export-on-exit ./emulator-data",
    "test:integration": "npm run build:functions && firebase emulators:exec --only auth,functions,firestore --project demo-ridemesh \"vitest run --config vitest.integration.config.mts\"",
    "admin:set-staff-role": "npm run build:functions && node scripts/set-staff-role.mjs",
    "admin:backfill-driver-profiles": "npm run build:functions && node scripts/backfill-driver-profiles.mjs",
    "admin:review": "npm run build:functions && node scripts/review-driver.mjs",
    "test:e2e": "npm run build:functions && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.30.2",
    "globals": "^16.0.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
