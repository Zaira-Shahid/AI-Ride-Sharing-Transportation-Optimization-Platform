{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "lib"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 19099
    },
    "functions": {
      "port": 15001
    },
    "firestore": {
      "port": 18080,
      "websocketPort": 19150
    },
    "ui": {
      "enabled": false
    },
    "hub": {
      "port": 14400
    },
    "logging": {
      "port": 14500
    },
    "eventarc": {
      "port": 19299
    },
    "tasks": {
      "port": 19499
    }
  }
}
