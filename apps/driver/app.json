{
  "expo": {
    "name": "RideMesh Driver",
    "slug": "ridemesh-driver",
    "scheme": "ridemesh-driver",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.ridemesh.driver"
    },
    "android": {
      "package": "com.ridemesh.driver"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RideMesh uses your location to show where you are on the map."
        }
      ]
    ]
  }
}
