# Firebase web app configuration (Firebase console > Project settings > Your apps).
# Copy this file to .env and fill in the values. Never commit .env.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform key for place search (Places API (New)). Create it in the Google Cloud
# console, restrict it to that API and to this app (see docs/development.md), and never commit it.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Set to the machine running the Firebase emulators (for example 127.0.0.1, or 10.0.2.2
# from an Android emulator) to develop against them instead of the real project.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
