rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Roles come from a custom claim that only server-side code can set. A `role` field inside a
    // document is never used for authorization.
    function role() {
      return request.auth.token.get('role', '');
    }

    function isStaff() {
      return isVerified() && role() in ['SUPPORT', 'OPERATIONS', 'ADMIN', 'SUPER_ADMIN'];
    }

    // A person may change only their name and phone, and updatedAt must carry the server's clock.
    // Every other field (role, email, status, ...) is locked: adding, changing or removing any of
    // them shows up in affectedKeys() and is denied. Keep the phone pattern in step with
    // packages/types/src/auth.ts.
    function isValidContactUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'phone', 'updatedAt'])
          && changed.hasAll(['updatedAt'])
          && data.updatedAt == request.time
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 100
          && data.name.matches('.*\\S.*')
          && (data.get('phone', null) == null
              || (data.phone is string && data.phone.matches('^[+0-9 ().-]{7,32}$')));
    }

    // Profiles are created by server-side code only. A person can then edit their own contact
    // details directly, so no Cloud Function is needed for it.
    match /users/{userId} {
      allow read: if isVerified() && (request.auth.uid == userId || isStaff());
      allow create, delete: if false;
      allow update: if isVerified()
                    && request.auth.uid == userId
                    && resource.data.status == 'ACTIVE'
                    && isValidContactUpdate();
    }

    // Driver profiles are keyed by the driver's uid. They are created by server-side code when a
    // driver registers. The driver can read their own; nothing is writable from a client yet. Each
    // later Phase 2 module opens only the specific fields it owns.
    match /drivers/{driverId} {
      allow read: if isVerified()
                  && ((request.auth.uid == driverId && role() == 'DRIVER') || isStaff());
      allow write: if false;
    }

    // A driver has one vehicle, keyed by their uid. Only the saveVehicle function creates or changes
    // it (it must enforce a unique plate number, which rules cannot). The driver can read their own.
    match /vehicles/{vehicleId} {
      allow read: if isVerified()
                  && ((request.auth.uid == vehicleId && role() == 'DRIVER') || isStaff());
      allow write: if false;
    }

    // Every other collection stays closed until the module that owns it defines its rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
