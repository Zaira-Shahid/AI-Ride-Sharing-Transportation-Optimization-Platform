# Read by the emulators `npm run load` starts (project demo-ridemesh-load) and by nothing else.
# Like .env.demo-ridemesh (routes go to the fake OSRM the load test runs itself) with two differences,
# on purpose: the route spacing is NOT turned off, so the REAL limit of one lookup every 1.1 seconds
# for the whole system applies, which is the thing being measured; and there is no optimization service
# URL, so the event-triggered batch runs do nothing and cannot share the route counters with a run the
# test makes itself.
ROUTING_BASE_URL_DRIVING=http://127.0.0.1:18890/routed-car
ROUTING_BASE_URL_WALKING=http://127.0.0.1:18890/routed-foot
ROUTING_USER_AGENT=RideMesh-load
